# Copy to .env and adjust. Never commit a real .env.
#   cp .env.example .env

# ---------------------------------------------------------------- required
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret

# ---------------------------------------------------------------- database
POSTGRES_USER=servicemesh
POSTGRES_PASSWORD=servicemesh
POSTGRES_PORT=5432
# Used when running the core outside Docker. Inside Docker this is set by
# docker-compose and points at the `postgres` service.
DATABASE_URL=sqlite+pysqlite:///./data/servicemesh.db

# ------------------------------------------------------------ application
ENVIRONMENT=local
DEBUG=true
ALLOW_DEMO_EXTERNAL_RECORDS=true
DEFAULT_SLA_HOURS=72

# --------------------------------------------------------------- providers
# `inproc` runs the organizations inside the core process (tests, quick local
# runs). `http` makes real network calls and is what docker-compose uses.
PROVIDER_TRANSPORT=inproc
MARKETPLACE_URL=http://marketplace:8101
MANUFACTURER_URL=http://manufacturer:8102
WARRANTY_URL=http://warranty:8103
SERVICE_CENTRE_URL=http://service-centre:8104
PARTS_SUPPLIER_URL=http://parts-supplier:8105

# Each organization authenticates differently on purpose.
MARKETPLACE_API_KEY=mkt-dev-key
MANUFACTURER_TOKEN=oem-dev-token
WARRANTY_CLIENT_ID=wty-client
WARRANTY_CLIENT_SECRET=wty-secret
SERVICE_CENTRE_KEY=svc-dev-key
SUPPLIER_API_KEY=sup-dev-key

# -------------------------------------------------------------- resilience
PROVIDER_TIMEOUT_SECONDS=5
DEFAULT_MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.2
RETRY_MAX_DELAY_SECONDS=5
# Tests set this to 0 so backoff is asserted, not slept through.
RETRY_DELAY_MULTIPLIER=1

# ------------------------------------------------------------------ events
# `memory` persists and dispatches events in-process and is fully functional.
# `kafka` additionally publishes to Redpanda (docker compose --profile events).
EVENT_BACKEND=memory
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_PREFIX=servicemesh

# ------------------------------------------------------------- ML / GenAI
ML_ENABLED=true
ML_MODEL_PATH=artifacts/provider_risk_model.joblib
# The system is fully functional with GenAI disabled; extraction falls back to
# the deterministic rule-based extractor.
GENAI_ENABLED=false
GENAI_API_KEY=

# ---------------------------------------------------------------- frontend
VITE_API_BASE_URL=http://localhost:8000
