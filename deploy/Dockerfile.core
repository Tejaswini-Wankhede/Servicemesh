# ServiceMesh Core API
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl build-essential libpq-dev \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY servicemesh ./servicemesh
COPY providers ./providers
COPY scripts ./scripts

RUN pip install --upgrade pip && pip install ".[postgres,ml]"

# Run as a non-root user.
RUN useradd --create-home --uid 10001 servicemesh && chown -R servicemesh /app
USER servicemesh

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "servicemesh.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
