# One image, five organizations. PROVIDER_MODULE selects which app runs.
# They are separate *containers* with separate *databases*; sharing the build
# context only avoids five nearly identical Dockerfiles.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl build-essential libpq-dev \
 && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY servicemesh ./servicemesh
COPY providers ./providers
COPY scripts ./scripts

RUN pip install --upgrade pip && pip install ".[postgres]"

RUN useradd --create-home --uid 10002 provider && chown -R provider /app
USER provider

ARG PROVIDER_MODULE=providers.marketplace.app
ARG PROVIDER_PORT=8101
ENV PROVIDER_MODULE=${PROVIDER_MODULE} PROVIDER_PORT=${PROVIDER_PORT}

EXPOSE ${PROVIDER_PORT}
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD curl -fsS http://localhost:${PROVIDER_PORT}/health || exit 1

CMD ["sh", "-c", "uvicorn ${PROVIDER_MODULE}:app --host 0.0.0.0 --port ${PROVIDER_PORT}"]
